# ค่าคงที่ของ fixture สำหรับ dev/test เท่านั้น — ห้ามใช้กับ production
# seed-dev-fixture.sh สร้างบัญชีตามนี้ และ test-rest-integration.sh ใช้ค่าเดียวกัน login

FIXTURE_USER_EMAIL="${FIXTURE_USER_EMAIL:-dev-user@chata.test}"
FIXTURE_USER_PASSWORD="${FIXTURE_USER_PASSWORD:-dev-password-123}"

FIXTURE_SEER_EMAIL="${FIXTURE_SEER_EMAIL:-dev-seer@chata.test}"
FIXTURE_SEER_PASSWORD="${FIXTURE_SEER_PASSWORD:-dev-password-123}"

FIXTURE_SEER_DISPLAY_NAME="${FIXTURE_SEER_DISPLAY_NAME:-หมอดูทดสอบ}"
FIXTURE_SEER_PRICE_COIN="${FIXTURE_SEER_PRICE_COIN:-150}"
FIXTURE_USER_START_COIN="${FIXTURE_USER_START_COIN:-1000}"

FIXTURE_OUTSIDER_EMAIL="${FIXTURE_OUTSIDER_EMAIL:-dev-outsider@chata.test}"
FIXTURE_OUTSIDER_PASSWORD="${FIXTURE_OUTSIDER_PASSWORD:-dev-password-123}"
