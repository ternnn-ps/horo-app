# ค่าคงที่ของ fixture สำหรับ dev/test เท่านั้น — ห้ามใช้กับ production
#
# อีเมล/รหัสผ่านตรงกับ TestAccount ในแอป (ContentView) โดยตั้งใจ:
# รัน fixture ครั้งเดียวแล้วทั้งแอปและชุดเทส login ได้ด้วยบัญชีชุดเดียวกัน
# seed-dev-fixture.sh สร้างบัญชีตามนี้ และ test-rest-integration.sh ใช้ค่าเดียวกัน login

FIXTURE_USER_EMAIL="${FIXTURE_USER_EMAIL:-customer@horo.test}"
FIXTURE_USER_PASSWORD="${FIXTURE_USER_PASSWORD:-HoroTest123!}"

FIXTURE_SEER_EMAIL="${FIXTURE_SEER_EMAIL:-seer@horo.test}"
FIXTURE_SEER_PASSWORD="${FIXTURE_SEER_PASSWORD:-HoroTest123!}"

FIXTURE_SEER_DISPLAY_NAME="${FIXTURE_SEER_DISPLAY_NAME:-หมอดูทดสอบ}"
FIXTURE_SEER_PRICE_COIN="${FIXTURE_SEER_PRICE_COIN:-150}"
FIXTURE_USER_START_COIN="${FIXTURE_USER_START_COIN:-1000}"

FIXTURE_OUTSIDER_EMAIL="${FIXTURE_OUTSIDER_EMAIL:-outsider@horo.test}"
FIXTURE_OUTSIDER_PASSWORD="${FIXTURE_OUTSIDER_PASSWORD:-HoroTest123!}"
